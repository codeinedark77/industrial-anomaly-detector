# Copy to .env and adjust if you change docker-compose defaults.
# Every service reads these; unset values fall back to the
# localhost/default-port values shown here.

MQTT_HOST=localhost
MQTT_PORT=1883

DATABASE_URL=postgresql://radar:radar@localhost:5432/radar

# Optional. Unset = API auth disabled (local dev default).
API_KEY=

# Each service's Prometheus /metrics port has its own built-in
# default (ingestion 9101, maintenance detector 9102, security
# detector 9103 - see README) via the same METRICS_PORT variable
# name, so it's deliberately NOT set here: putting one value in this
# shared file would make all three services fight over one port.
# Override per-process only if you actually need to, e.g.:
#   METRICS_PORT=9201 python consumer.py
